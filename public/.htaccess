# For Apache and LiteSpeed hosting (cPanel and similar). Vercel, Netlify and
# Cloudflare Pages ignore this file and use vercel.json or _headers instead.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType font/woff2 .woff2

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One address for the whole site: https://monobook.co, no www.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://monobook.co%{REQUEST_URI} [R=301,L]

  # /index.html is the home page, so send it to /.
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ / [R=301,L]

  # Folders the export leaves behind are not pages.
  RewriteRule ^(404|_not-found)(/.*)?$ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Next's page data files load in the background; they are not pages to index.
  <FilesMatch "\.txt$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
  <Files "robots.txt">
    Header unset X-Robots-Tag
  </Files>

  # Scripts, styles and fonts have a content hash in their name, so they can be cached for a year.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Pages are checked on every visit, so an update shows at once.
  <FilesMatch "\.(html|txt|xml|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/xml text/plain image/svg+xml application/manifest+json
</IfModule>
